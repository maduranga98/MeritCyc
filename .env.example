# =============================================================================
# MeritCyc — frontend environment variables
# Copy to `.env` and fill in values from the Firebase console
# (Project settings → General → Your apps → SDK setup and configuration).
# `.env` is gitignored — never commit real credentials.
# =============================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Required for the Realtime Database client (budget tracking).
# Format: https://<project-id>-default-rtdb.<region>.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=
